<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] - AgriStream IoT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-success px-4"><a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">AgriStream IoT</a>@if(User.Identity?.IsAuthenticated == true){
        <div class="navbar-nav me-auto"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a><a class="nav-link" asp-controller="DroneImages" asp-action="Index">Images</a><a class="nav-link" asp-controller="Irrigation" asp-action="Index">Irrigation</a></div><form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-outline-light">Logout</button></form>
    }
</nav>
<main class="container py-4">@RenderBody()</main>@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
