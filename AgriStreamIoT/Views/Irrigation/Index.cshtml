@model IrrigationCommandModel
@{
    ViewData["Title"] = "Irrigation";
}
<h2>Trigger irrigation</h2>@if(TempData["Message"] != null){
<div class="alert alert-success">@TempData["Message"]</div>
}
<form method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="DeviceId"></label><input asp-for="DeviceId" class="form-control mb-3" /><label asp-for="FieldId"></label><input asp-for="FieldId" class="form-control mb-3" /><button class="btn btn-success">Queue irrigation</button></form>
