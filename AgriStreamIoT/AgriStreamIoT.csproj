
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0a6ba772-036d-4668-b124-f7f7b78ecc4f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>

    <!-- Azure Blob Storage -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />

    <!-- Azure Queue Storage -->
    <PackageReference Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />

    <!-- Entity Framework Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>
        runtime; build; native; contentfiles;
        analyzers; buildtransitive
      </IncludeAssets>
    </PackageReference>

    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />

  </ItemGroup>

</Project>
